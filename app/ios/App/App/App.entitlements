<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- One build for iPhone, iPad, Apple Vision Pro and Apple silicon Macs:
	     the iPad app runs as it is on the last two, inside the sandbox the
	     system gives it, so no sandbox entitlement is declared here. Sign in
	     with Apple is required by guideline 4.8 the moment any third-party
	     login ships, and the native sheet needs the entitlement; the matching
	     capability must also be ticked on the App ID in the developer portal. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
</dict>
</plist>
