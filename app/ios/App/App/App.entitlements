<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The Mac App Store requires a sandboxed app. This one needs almost
	     nothing from outside it: every scan is in the bundle, there is no
	     network call to make, and the only thing it ever writes is a
	     snapshot the reader asked for, to a place the reader picked. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Accounts changed two things. Outgoing connections: the optional
	     sign-in talks to Firebase, and the Mac sandbox blocks even that
	     without this (iOS ignores it). Sign in with Apple: required by
	     guideline 4.8 the moment any third-party login ships, and the
	     native sheet needs the entitlement; the matching capability must
	     also be ticked on the App ID in the developer portal. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
</dict>
</plist>
