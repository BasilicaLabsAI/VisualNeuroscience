# Copy to android/keystore.properties (git-ignored) and fill in. storeFile is
# relative to android/. Make the key once and keep it somewhere safe:
#   keytool -genkeypair -v -keystore upload-keystore.jks -alias upload -keyalg RSA -keysize 2048 -validity 10000
# Play App Signing keeps the app's real signing key; this one only signs uploads.
storeFile=upload-keystore.jks
storePassword=
keyAlias=upload
keyPassword=
