rules_version = '2';

// VisualNeuroscience.AI — Firestore security rules.
// Paste into Firebase console → Firestore Database → Rules (or deploy with
// `firebase deploy --only firestore:rules`). See docs/AUTH-SETUP.md.

service cloud.firestore {
  match /databases/{database}/documents {

    // Each person owns exactly their own tree and nothing else: profile,
    // saved files per tool, anything later added under users/{uid}/….
    // No one can read another person's data, signed in or not.
    // (Firestore itself caps any document at 1 MB, which is the size guard.)
    match /users/{uid}/{rest=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == uid;
    }

    // The LinkedIn sub → Firebase uid mapping is written and read only by
    // the auth-worker, which uses service-account credentials that bypass
    // these rules entirely. No client touches it, so no client may.
    match /linkedinLinks/{sub} {
      allow read, write: if false;
    }

    // Everything not named above is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
